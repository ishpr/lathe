      {"from": "in_review", "to": "approved", "guards": ["evidence:review_approval.non_author", "evidence:ci_run.green.binding", "ci_matches_approval", "actor:human|ci"]},
      {"from": "approved", "to": "merged", "guards": ["evidence:merge_sha", "merge_head_matches_ci", "actor:human|ci"]},
      {"from": "in_review", "to": "merged", "guards": ["evidence:merge_sha", "merge_head_matches_ci", "actor:human"]}
    ]
  },
